<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:ignore="HardcodedText,TextContrastCheck,Autofill">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MÓDULO MÓVIL - GESTIÓN DE USUARIOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre completo (Obligatorio)"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico (Obligatorio)"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rol (ADMIN / USER)"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRAR USUARIO (POST)"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etIdEliminar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ID a eliminar"
                android:inputType="number"
                android:minHeight="48dp"/>

            <Button
                android:id="@+id/btnEliminar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELIMINAR (DELETE)"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listado de Usuarios Activos (GET):"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvListaUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textColor="#334155"
            android:textSize="14sp"
            android:text="Cargando usuarios..."/>

    </LinearLayout>
</ScrollView>